<!doctype html>
<meta charset="utf-8">
<style>
  @font-face { font-family: "NR"; src: url("{{NEWSREADER}}") format("woff2"); font-weight: 200 800; }
  * { box-sizing: border-box; margin: 0; }
  html, body { width: 512px; height: 512px; overflow: hidden; background: transparent; }
  /* The site's one yellow, as a tile, with the serif K in the ink. */
  .f { position: relative; width: 512px; height: 512px; border-radius: 104px;
       background: #f7ef96; display: grid; place-items: center; }
  .k { font: 500 420px/1 "NR", Georgia, serif; color: #1f2b27; padding-top: 60px; letter-spacing: -0.02em; }
</style>
<div class="f"><div class="k">K</div></div>
