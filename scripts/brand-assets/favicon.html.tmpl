<!doctype html>
<meta charset="utf-8">
<style>
  * { box-sizing: border-box; margin: 0; }
  html, body { width: 512px; height: 512px; overflow: hidden; background: transparent; }
  /* A CAD viewport: the K is built as real 3D geometry (a prism, 22 vertices
     and 33 edges), turned a little, and drawn as a wireframe. Edges on faces
     that point away are dashed, the way a CAD view shows hidden lines.
     {{THEME}} is "dark" (yellow lines on the ink) or "light" (ink on the yellow),
     {{STROKE}} the line weight in px, and {{DETAIL}} how much is drawn:
     3 = grid, axes and vertex grips as well; 2 = all edges; 1 = all edges, no
     hidden lines; 0 = only the front outline and a fainter back outline, for
     16 px, where anything more turns to mush. */
  .f { width: 512px; height: 512px; border-radius: 104px; overflow: hidden; }
  svg { display: block; width: 512px; height: 512px; }
</style>
<div class="f"><svg id="s" viewBox="0 0 512 512"></svg></div>
<script>
(function () {
  var THEME = "{{THEME}}", STROKE = {{STROKE}}, DETAIL = {{DETAIL}};
  var tile = THEME === "dark" ? "#1f2b27" : "#f7ef96";
  var ink  = THEME === "dark" ? "#f7ef96" : "#1f2b27";
  var rgb  = THEME === "dark" ? "247,239,150" : "31,43,39";

  // The K, as a flat outline in unit space (a geometric sans: stem, arm, leg).
  var P = [[0,0],[.22,0],[.22,.40],[.60,0],[.88,0],[.46,.50],[.86,1],[.58,1],[.22,.60],[.22,1],[0,1]];
  var N = P.length, D = 0.30;
  var V = [];
  P.forEach(function (p) { V.push([p[0] - .44, p[1] - .5,  D / 2]); });   // front
  P.forEach(function (p) { V.push([p[0] - .44, p[1] - .5, -D / 2]); });   // back

  var yaw = -30 * Math.PI / 180, pitch = 21 * Math.PI / 180, F = 4.2;
  var cy = Math.cos(yaw), sy = Math.sin(yaw), cx = Math.cos(pitch), sx = Math.sin(pitch);
  function rot(v) {
    var x = v[0] * cy + v[2] * sy, z = -v[0] * sy + v[2] * cy;
    var y = v[1] * cx - z * sx;  z = v[1] * sx + z * cx;
    return [x, y, z];
  }
  function proj(v) { var r = rot(v), s = F / (F - r[2]); return [r[0] * s, -r[1] * s, r[2]]; }

  var Q = V.map(proj);
  // Fit the K into the tile.
  var xs = Q.map(function (q) { return q[0]; }), ys = Q.map(function (q) { return q[1]; });
  var minx = Math.min.apply(null, xs), maxx = Math.max.apply(null, xs), miny = Math.min.apply(null, ys), maxy = Math.max.apply(null, ys);
  var margin = DETAIL >= 3 ? 84 : (DETAIL === 0 ? 50 : 62);
  var k = (512 - 2 * margin) / Math.max(maxx - minx, maxy - miny);
  var ox = 256 - k * (minx + maxx) / 2, oy = 256 - k * (miny + maxy) / 2 + (DETAIL >= 3 ? -8 : 0);
  function T(q) { return [ox + k * q[0], oy + k * q[1]]; }

  // Which faces point at the viewer (z towards the viewer is positive here).
  var area = 0;
  for (var i = 0; i < N; i++) { var a = P[i], b = P[(i + 1) % N]; area += a[0] * b[1] - b[0] * a[1]; }
  var ccw = area > 0;
  function faces(nv) { return rot(nv)[2] > 0; }
  var frontUp = faces([0, 0, 1]), backUp = faces([0, 0, -1]);
  var sideUp = P.map(function (a, i) {
    var b = P[(i + 1) % N], dx = b[0] - a[0], dy = b[1] - a[1];
    return faces(ccw ? [dy, -dx, 0] : [-dy, dx, 0]);
  });

  var edges = [];   // [from, to, visible]
  for (var i = 0; i < N; i++) {
    var j = (i + 1) % N;
    edges.push([i, j, frontUp || sideUp[i]]);                 // front outline
    edges.push([i + N, j + N, backUp || sideUp[i]]);          // back outline
    if (DETAIL > 0) edges.push([i, i + N, sideUp[(i + N - 1) % N] || sideUp[i]]); // joins
  }

  var NS = "http://www.w3.org/2000/svg", s = document.getElementById("s");
  function el(n, a) { var e = document.createElementNS(NS, n); for (var q in a) e.setAttribute(q, a[q]); s.appendChild(e); return e; }
  el("rect", { width: 512, height: 512, fill: tile });

  if (DETAIL >= 3) {
    // A ground grid under the K, and a small axis triad.
    var fy = -0.5 - 0.07, g = [];
    for (var t = -1.2; t <= 1.2001; t += 0.3) {
      var a = T(proj([t, fy, -1.2])), b = T(proj([t, fy, 1.2])), c = T(proj([-1.2, fy, t])), d = T(proj([1.2, fy, t]));
      el("line", { x1: a[0], y1: a[1], x2: b[0], y2: b[1], stroke: "rgba(" + rgb + ",.16)", "stroke-width": 2 });
      el("line", { x1: c[0], y1: c[1], x2: d[0], y2: d[1], stroke: "rgba(" + rgb + ",.16)", "stroke-width": 2 });
    }
    var o = [-0.95, fy, 0.95], O = T(proj(o));
    [[.3,0,0],[0,.3,0],[0,0,-.3]].forEach(function (v) {
      var e = T(proj([o[0] + v[0], o[1] + v[1], o[2] + v[2]]));
      el("line", { x1: O[0], y1: O[1], x2: e[0], y2: e[1], stroke: "rgba(" + rgb + ",.7)", "stroke-width": 3, "stroke-linecap": "round" });
    });
  }

  // Hidden edges first, dashed and fainter; then the visible ones.
  if (DETAIL === 0) {
    // Smallest size: the back outline as a fainter line, then the front outline.
    for (var i = 0; i < N; i++) {
      var j = (i + 1) % N, a = T(Q[i + N]), b = T(Q[j + N]);
      el("line", { x1: a[0], y1: a[1], x2: b[0], y2: b[1], stroke: "rgba(" + rgb + ",.55)", "stroke-width": STROKE * 0.75, "stroke-linecap": "round" });
    }
    for (var i = 0; i < N; i++) {
      var j = (i + 1) % N, a = T(Q[i]), b = T(Q[j]);
      el("line", { x1: a[0], y1: a[1], x2: b[0], y2: b[1], stroke: ink, "stroke-width": STROKE, "stroke-linecap": "round", "stroke-linejoin": "round" });
    }
  } else
  [false, true].forEach(function (vis) {
    edges.forEach(function (e) {
      if (e[2] !== vis) return;
      var a = T(Q[e[0]]), b = T(Q[e[1]]);
      var at = { x1: a[0], y1: a[1], x2: b[0], y2: b[1], "stroke-linecap": "round", "stroke-linejoin": "round" };
      if (vis) { at.stroke = ink; at["stroke-width"] = STROKE; }
      else if (DETAIL >= 2) { at.stroke = "rgba(" + rgb + ",.55)"; at["stroke-width"] = Math.max(2, STROKE * 0.6); at["stroke-dasharray"] = (STROKE * 1.6) + " " + (STROKE * 1.8); }
      else return;
      el("line", at);
    });
  });

  if (DETAIL >= 3) {
    // Vertex grips on the visible outline, as a CAD program shows a selection.
    var seen = {};
    edges.forEach(function (e) { if (e[2]) { seen[e[0]] = 1; seen[e[1]] = 1; } });
    Object.keys(seen).forEach(function (i) {
      var p = T(Q[i]);
      el("rect", { x: p[0] - 7, y: p[1] - 7, width: 14, height: 14, fill: tile, stroke: ink, "stroke-width": 2.5 });
    });
  }
})();
</script>
