<!doctype html>
<meta charset="utf-8">
<style>
  @font-face { font-family: "NR"; src: url("{{NEWSREADER}}") format("woff2"); font-weight: 200 800; }
  @font-face { font-family: "PM"; src: url("{{PLEX}}") format("woff2"); font-weight: 400; }
  * { box-sizing: border-box; margin: 0; }
  html, body { width: 1200px; height: 630px; overflow: hidden; background: #ffffff; }
  /* Plain white paper. */
  .card { position: relative; width: 1200px; height: 630px; overflow: hidden; isolation: isolate;
          background-color: #ffffff; color: #0e2419; }
  /* The Lorenz butterfly, drawn below, faded before it reaches the text. */
  .patt { position: absolute; inset: 0;
          -webkit-mask-image: radial-gradient(ellipse 52% 80% at 76% 46%, #000 0%, rgba(0,0,0,.6) 46%, transparent 84%); }
  canvas { position: absolute; left: 0; top: 0; width: 1200px; height: 630px; }
  /* The sketch on its soft paper halo: no card, no edge. */
  .pic { position: absolute; right: 64px; top: 34px; width: 450px; aspect-ratio: 900 / 1161; }
  .halo { position: absolute; inset: -3% -6%; background: url("{{HALO}}") center / 100% 100% no-repeat; }
  .pic img { position: relative; display: block; width: 100%; height: 100%; }
  .badge { position: absolute; left: -56px; bottom: 26px; width: 120px; height: 120px; transform: rotate(-6deg); }
  .badge text { fill: #0e2419; font: 300 21px "NR", Georgia, serif; }
  .badge text.in { fill: #e9ff3e; }
  .text { position: absolute; left: 0; top: 0; padding: 66px 72px 62px; width: 740px; height: 630px;
          display: flex; flex-direction: column; }
  .label { display: inline-flex; align-items: center; gap: 14px; font: 400 15px "PM", monospace;
           letter-spacing: 0.12em; white-space: nowrap; text-transform: uppercase; color: #4d6358; }
  .label::before { content: ""; width: 9px; height: 9px; border-radius: 50%; background: #1b6b45;
                   box-shadow: 0 0 0 4px rgba(233, 255, 62, .85); }
  h1 { font: 300 76px/1.04 "NR", Georgia, serif; letter-spacing: -0.022em; margin-top: 36px; max-width: 640px; }
  .who { display: flex; align-items: baseline; gap: 22px; margin-top: 34px; font: 400 25px "NR", Georgia, serif; letter-spacing: -0.01em; }
  .who .id { color: #1b6b45; }
  .foot { margin-top: auto; }
  .rule { width: 64px; height: 2px; background: #e9ff3e; margin-bottom: 20px; box-shadow: 0 0 0 1px rgba(14,36,25,.18); }
  .proof { font: 400 18px "PM", monospace; letter-spacing: 0.1em; text-transform: uppercase; color: #2f4338; }
  .proof b { font-weight: 400; color: #1b6b45; padding: 0 10px; }
  .url { font: 400 19px "PM", monospace; letter-spacing: 0.1em; color: #4d6358; margin-top: 10px; }
</style>
<div class="card">
  <div class="patt"><canvas id="h" width="2400" height="1260"></canvas></div>
  <div class="pic">
    <div class="halo"></div>
    <img src="{{PORTRAIT}}" alt="">
    <svg class="badge" viewBox="0 0 120 120">
      <circle cx="60" cy="60" r="58" fill="#e9ff3e" stroke="#0e2419" stroke-width="1"/>
      <circle cx="60" cy="60" r="51.5" fill="none" stroke="#0e2419" stroke-width="0.7" stroke-dasharray="1.6 3.2" stroke-linecap="round"/>
      <g transform="rotate(-11 60 60)">
        <text x="15" y="67" textLength="58" lengthAdjust="spacingAndGlyphs">Linked</text>
        <rect x="77" y="46" width="27" height="27" rx="4.5" fill="#0e2419"/>
        <text class="in" x="82" y="67" textLength="17" lengthAdjust="spacingAndGlyphs">in</text>
      </g>
      <path d="M82 22 l8 -8 m-6 0 h6 v6" fill="none" stroke="#0e2419" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" transform="translate(-4 4)"/>
    </svg>
  </div>
  <div class="text">
    <div class="label">Founder's office &middot; GTM &middot; Cross-border ops</div>
    <h1>Helping founders<br>build from idea<br>to execution.</h1>
    <div class="who"><span>Komal Kedarnath</span><span class="id">Startups-Operator. Maker. Explorer.</span></div>
    <div class="foot">
      <div class="rule"></div>
      <div class="proof">6+ years<b>&middot;</b>4 ventures<b>&middot;</b>4 countries</div>
      <div class="url">komalkedarnath.wiki</div>
    </div>
  </div>
</div>
<script>
  // The same Lorenz butterfly as the home page (src/lib/patterns.ts, seed 0):
  // five strands of the attractor seen from a slant, in thin ink. Drawn at
  // twice size because the card is rendered at twice size.
  (function () {
    var c = document.getElementById("h"), ctx = c.getContext("2d"), K = 2;
    var W = 1200 * K, H = 630 * K;
    function rng(seed) { var s = (seed >>> 0) || 1; return function () { s = (Math.imul(s, 1664525) + 1013904223) >>> 0; return s / 4294967296; }; }
    var r = rng(0 + 41);
    var yaw = 0.45 + (r() - 0.5) * 0.5, cos = Math.cos(yaw), sin = Math.sin(yaw);
    var s = Math.min(W * 0.5 / 54, H * 0.92 / 52) * 1.12, cx = W * 0.76, cy = H * 0.46;
    function rk(p, h) {
      function d(x, y, z) { return [10 * (y - x), x * (28 - z) - y, x * y - (8 / 3) * z]; }
      var a = d(p[0], p[1], p[2]);
      var b = d(p[0] + 0.5 * h * a[0], p[1] + 0.5 * h * a[1], p[2] + 0.5 * h * a[2]);
      var cc = d(p[0] + 0.5 * h * b[0], p[1] + 0.5 * h * b[1], p[2] + 0.5 * h * b[2]);
      var e = d(p[0] + h * cc[0], p[1] + h * cc[1], p[2] + h * cc[2]);
      for (var i = 0; i < 3; i++) p[i] += (h / 6) * (a[i] + 2 * b[i] + 2 * cc[i] + e[i]);
    }
    function at(p) { return [cx + s * (p[0] * cos + p[1] * sin), cy - s * (p[2] - 24)]; }
    ctx.lineWidth = 0.7 * K; ctx.lineCap = "round"; ctx.lineJoin = "round"; ctx.strokeStyle = "rgba(14,36,25,0.34)";
    for (var k = 0; k < 5; k++) {
      var p = [(r() - 0.5) * 30, (r() - 0.5) * 36, 5 + r() * 40];
      for (var i = 0; i < 900; i++) rk(p, 0.006);
      var q = at(p);
      for (var j = 0; j < 5000; j += 24) {
        ctx.beginPath(); ctx.moveTo(q[0], q[1]);
        for (var m = 0; m < 24; m++) { rk(p, 0.006); q = at(p); ctx.lineTo(q[0], q[1]); }
        ctx.stroke();
      }
    }
  })();
</script>
